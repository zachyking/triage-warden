# Copy this file to a local path such as:
#   config/local/e2e-real.env
#
# Then fill every blank value before running:
#   ./scripts/bootstrap-e2e-infra.sh --mode real --env-file config/local/e2e-real.env --connector-config config/examples/e2e-real-connectors.json

# Core stack
TW_E2E_ADMIN_PASSWORD=
TW_E2E_TENANT_ID=00000000-0000-0000-0000-000000000001
TW_E2E_USER_EMAIL_DOMAIN=tw-fakeco.local

# Optional local port overrides
# TW_E2E_API_PORT=8081
# TW_E2E_TRIAGE_PORT=8092
# TW_E2E_POSTGRES_PORT=5433
# TW_E2E_REDIS_PORT=6380
# TW_E2E_QDRANT_HTTP_PORT=6335
# TW_E2E_QDRANT_GRPC_PORT=6336

# Live triage service configuration
TW_LLM_PROVIDER=openai
TW_LLM_MODEL=gpt-4.1-mini

# Set either TW_LLM_API_KEY or the provider-specific key.
TW_LLM_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# VirusTotal
TW_E2E_VT_API_KEY=
TW_E2E_VT_REQUESTS_PER_MINUTE=4

# Jira
TW_E2E_JIRA_BASE_URL=
TW_E2E_JIRA_PROJECT_KEY=SEC
TW_E2E_JIRA_USERNAME=
TW_E2E_JIRA_API_TOKEN=

# Splunk
TW_E2E_SPLUNK_BASE_URL=
TW_E2E_SPLUNK_TOKEN=
TW_E2E_SPLUNK_APP=search
TW_E2E_SPLUNK_OWNER=-
TW_E2E_SPLUNK_OUTPUT_MODE=json

# CrowdStrike
TW_E2E_CROWDSTRIKE_CLIENT_ID=
TW_E2E_CROWDSTRIKE_CLIENT_SECRET=
TW_E2E_CROWDSTRIKE_REGION=us-1

# Microsoft 365
TW_E2E_M365_TENANT_ID=
TW_E2E_M365_CLIENT_ID=
TW_E2E_M365_CLIENT_SECRET=

# Optional local persona passwords for the fake organization
# If unset, seed-e2e-personas.sh falls back to deterministic local-only defaults.
TW_E2E_INCIDENT_MANAGER_PASSWORD=
TW_E2E_APPROVER_SECURITY_PASSWORD=
TW_E2E_ANALYST_LEVEL1_PASSWORD=
TW_E2E_ANALYST_LEVEL2_PASSWORD=
TW_E2E_VIEWER_EXEC_PASSWORD=
